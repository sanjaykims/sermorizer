# Copy to .env.local and fill in.
# Your Anthropic API key — used server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the built-in Supabase project used to store summaries.
# The app already ships with a public project + publishable key baked in, so
# these are only needed if you want to point Sermorizer at a different project.
# Both are public-safe (browser-exposed); access is governed by table RLS.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
